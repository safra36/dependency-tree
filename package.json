{
  "name": "ai-coding-agent",
  "version": "1.1.0",
  "description": "A powerful AI coding agent with Claude integration, dependency analysis and line tracking for intelligent code editing",
  "main": "dist/interactive-cli.js",
  "bin": {
    "ai-agent": "./dist/ai-agent.js",
    "ai-code": "./bin/ai-agent",
    "deps-tree": "./dependancy-tree.js"
  },
  "preferGlobal": true,
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "start": "npm run interactive",
    "interactive": "npm run build && node dist/interactive-cli.js",
    "agent": "npm run interactive",
    "prepublishOnly": "npm run build",
    "postinstall": "npm run build || echo 'Build failed, please run npm run build manually'",
    "test:ai": "npm run build && node -e \"const {AnthropicService} = require('./dist/anthropic-service'); new AnthropicService({apiKey: process.env.ANTHROPIC_API_KEY}).testConnection().then(r => console.log('AI Connection:', r ? 'OK' : 'Failed'))\"",
    "setup": "npm install && npm run build && echo '✅ Setup complete!'",
    "global:install": "npm run build && npm link",
    "global:uninstall": "npm unlink",
    "help": "echo 'Available commands: ai-agent, ai-code, deps-tree'"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "claude",
    "anthropic",
    "dependency-analysis",
    "code-editing",
    "typescript",
    "refactoring",
    "line-tracking",
    "interactive",
    "automation",
    "cli",
    "global"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist/",
    "bin/",
    "dependancy-tree.js",
    "README.md",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/ai-coding-agent.git"
  }
}
