# path: .env.example

# ===============================================
# AI Coding Agent Configuration
# ===============================================

# Required: Your Anthropic API Key
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: AI Model Configuration
# Available models: claude-3-5-sonnet-20241022, claude-3-haiku-20240307, claude-3-opus-20240229
AI_AGENT_MODEL=claude-3-5-sonnet-20241022

# Optional: Response Configuration
# Max tokens for AI responses (1-200000)
AI_AGENT_MAX_TOKENS=8192

# Temperature for AI creativity (0.0-1.0)
# Lower = more focused, Higher = more creative
AI_AGENT_TEMPERATURE=0.1

# Optional: Debug Configuration
# Enable detailed logging (true/false)
AI_AGENT_DEBUG=false

# Optional: Project Configuration
# Default project root (leave empty for current directory)
AI_AGENT_PROJECT_ROOT=

# Dependency analysis depth (1-10)
AI_AGENT_MAX_DEPTH=3

# ===============================================
# Usage Instructions
# ===============================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Set your Anthropic API key:
#    - Get it from https://console.anthropic.com/
#    - Replace 'your_anthropic_api_key_here' with your actual key
#
# 3. Optional: Customize other settings
#
# 4. Start the agent:
#    npm start
#
# ===============================================
# Environment Variables Priority
# ===============================================
#
# The agent uses configuration in this order:
# 1. Environment variables (highest priority)
# 2. Config file (~/.ai-coding-agent/config.json)
# 3. Default values (lowest priority)
#
# ===============================================