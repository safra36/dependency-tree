// path: tsconfig.json
{
	"compilerOptions": {
    "allowJs": true,
		"target": "ES2020",
		"module": "CommonJS",
		"lib": ["ES2020"],
		"outDir": "./dist",
		"rootDir": "./",

		"strict": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,

		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,

		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,

		"moduleResolution": "node",
		"baseUrl": "./",
		"paths": {
			"@/*": ["src/*"]
		},

		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,

		"removeComments": false,
		"preserveConstEnums": true,

		"typeRoots": ["./node_modules/@types"],

		"incremental": true,
		"tsBuildInfoFile": "./dist/.tsbuildinfo"
	},
	"include": [
		"*.ts", 
		"src/**/*.ts", 
		"bin/**/*.ts", 
		"*.js", 
		"src/**/*.js",
		"old/interactive-cli.ts",
		"colors.ts"
, "anthropic-service.ts", "old/cli.ts", "config-manager.ts", "old/content-parser.ts", "old/enhanced-ai-agent.ts", "old/enhanced-anthropic-service.ts", "old/enhanced-interactive-cli.ts", "old/line-tracker-editor.ts", "old/log-analyzer.ts", "old/ai-agent.ts", "old/ai-coding-agent.ts", "old/ai-prompt-system.ts", "old/project-analyzer.ts", "old/separator-content-parser.ts", "shell-executor.ts", "old/simple-cli.ts", "old/simplified-ai-agent.ts", "old/smart-file-editor.ts", "syntax-checker.ts", "old/systematic-ai-agent.ts"	],
	"exclude": [
		"node_modules",
		"dist",
		"**/*.test.ts",
		"**/*.spec.ts",
		"**/*.d.ts"
	],
	"ts-node": {
		"esm": false,
		"compilerOptions": {
			"module": "CommonJS"
		}
	}
}